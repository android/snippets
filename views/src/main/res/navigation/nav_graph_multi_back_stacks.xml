<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/first_stack">

    <navigation
        android:id="@+id/first_stack"
        app:startDestination="@id/first_stack_start_destination">
        <fragment android:id="@+id/first_stack_start_destination" />
    </navigation>

    <navigation
        android:id="@+id/second_stack"
        app:startDestination="@id/second_stack_start_destination">
        <fragment android:id="@+id/second_stack_start_destination" />
    </navigation>

    <!-- [START android_views_navigation_multi_back_stacks_action] -->
    <action
      android:id="@+id/swap_stack"
      app:destination="@id/second_stack"
      app:restoreState="true"
      app:popUpTo="@id/first_stack_start_destination"
      app:popUpToSaveState="true" />
    <!-- [END android_views_navigation_multi_back_stacks_action] -->
</navigation>
