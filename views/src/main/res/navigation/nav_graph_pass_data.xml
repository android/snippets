<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/myFragment">

    <!-- [START android_views_navigation_pass_data_destination_argument] -->
    <fragment android:id="@+id/myFragment" >
        <argument
            android:name="myArg"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
    <!-- [END android_views_navigation_pass_data_destination_argument] -->

    <!-- [START android_views_navigation_pass_data_action_argument] -->
    <action android:id="@+id/startMyFragment"
        app:destination="@+id/myFragment">
        <argument
            android:name="myArg"
            app:argType="integer"
            android:defaultValue="1" />
    </action>
    <!-- [END android_views_navigation_pass_data_action_argument] -->
</navigation>
