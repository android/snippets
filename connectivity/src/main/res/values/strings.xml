<resources>
    <!-- NetworkReceiver in ManagingNetworkUsage.kt shows these two in a Toast. -->
    <string name="wifi_connected">Wi-Fi reconnected.</string>
    <string name="lost_connection">Lost connection.</string>

    <!-- The network preference that preferences.xml shows to SettingsActivity. -->
    <string name="pref_download_title">Download feed</string>
    <string-array name="pref_download_entries">
        <item>Only when on Wi-Fi</item>
        <item>On any network</item>
    </string-array>
    <!-- NetworkActivity compares the stored value with its WIFI and ANY constants. -->
    <string-array name="pref_download_values" translatable="false">
        <item>Wi-Fi</item>
        <item>Any</item>
    </string-array>
</resources>
