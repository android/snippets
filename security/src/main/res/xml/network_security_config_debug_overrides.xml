<!-- [START android_security_network_config_debug_overrides] -->
<network-security-config>
    <!-- Production Configuration (Domains, Pinning, etc.) -->
    <domain-config>
        <domain includeSubdomains="true">api.example.com</domain>
        <!-- ... -->
    </domain-config>

    <!-- Debug-only overrides (applied only if android:debuggable="true") -->
    <debug-overrides>
        <trust-anchors>
            <!-- Trust user-added CAs in debug builds -->
            <certificates src="user" />
            <!-- Trust a private test CA only in debug builds -->
            <certificates src="@raw/debug_cas" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
<!-- [END android_security_network_config_debug_overrides] -->
