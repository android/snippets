<!-- [START android_security_network_config_debug_mock_server] -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Copy every domain-config from the main file here, unchanged. -->

    <!-- Debug builds only: the emulator's alias for the workstation. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
<!-- [END android_security_network_config_debug_mock_server] -->
