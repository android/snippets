<!-- [START android_security_ech_domain_encryption_xml] -->
<network-security-config>
    <!--
      Base Config (App-wide):
      Sets ECH to 'enabled' globally (can also be 'opportunistic' or 'required')
    -->
    <base-config>
        <domainEncryption mode="enabled"/>
    </base-config>

    <!--
      Domain Specific Config:
      Selectively disable ECH for specific domains that do not support it
    -->
    <domain-config>
        <domain includeSubdomains="true">disable-ech.example.com</domain>
        <domainEncryption mode="disabled"/>
    </domain-config>
</network-security-config>
<!-- [END android_security_ech_domain_encryption_xml] -->
