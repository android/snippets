<!-- [START android_security_network_config_pinning] -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 1. Enforce pinning for production API endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.example.com</domain>
        <!-- Example date. After it passes, the platform stops enforcing the pins. -->
        <pin-set expiration="2028-12-31">
            <!-- Example values only. Each pin is the base64 SHA-256 hash of the SPKI
                 of a real key: the key the server uses today and a backup key. -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBA=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
<!-- [END android_security_network_config_pinning] -->
